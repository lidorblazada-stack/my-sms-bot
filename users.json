# --- חלק 1: חלון ההשקעה (ה-Modal) ---
class InvestModal(ui.Modal, title='💰 בורסת סטלו - השקעה'):
    amount = ui.TextInput(label='כמות קרדיטים להשקעה', placeholder='כמה לשים?', min_length=1)

    async def on_submit(self, interaction: discord.Interaction):
        user_id = str(interaction.user.id)
        try:
            val = int(self.amount.value)
        except:
            return await interaction.response.send_message("❌ אחי, תכניס מספרים בלבד!", ephemeral=True)

        data = load_data() # פונקציית הטעינה שלך מה-users.json
        balance = data.get(user_id, {}).get('credits', 0)

        if val > balance:
            return await interaction.response.send_message(f"❌ אין לך מספיק! יתרה: {balance}", ephemeral=True)
        if val <= 0:
            return await interaction.response.send_message("❌ מינימום 1 קרדיט!", ephemeral=True)

        # הורדת הכסף והמתנה
        data[user_id]['credits'] -= val
        save_data(data)

        await interaction.response.send_message(f"⏳ מעבד השקעה של `{val}` קרדיטים... \n📊 בודק נתונים בבורסת סטלו...", ephemeral=True)
        await asyncio.sleep(3)

        # 30% סיכוי להכפיל
        if random.randint(1, 100) <= 30:
            data[user_id]['credits'] += (val * 2)
            save_data(data)
            await interaction.edit_original_response(content=f"🚀 **זכייה!** השוק עלה וקיבלת `{val * 2}` קרדיטים!")
        else:
            await interaction.edit_original_response(content=f"📉 **הפסד!** השוק קרס והקרדיטים הלכו.")

# --- חלק 2: הכפתורים וההסבר (ה-View וה-Setup) ---
class MarketView(ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @ui.button(label="להשקעה 💰", style=discord.ButtonStyle.green, custom_id="invest_btn")
    async def invest(self, interaction: discord.Interaction, button: ui.Button):
        await interaction.response.send_modal(InvestModal())

@bot.tree.command(name="market_setup", description="הצבת לוח הבורסה")
async def market_setup(interaction: discord.Interaction):
    # כאן בניתי את ההסבר בדיוק במקום מה שהיה בתמונה
    embed = discord.Embed(
        title="💹 בורסת סטלו - מערכת השקעות",
        description=(
            "**ברוך הבא לזירת המסחר!**\n\n"
            "כאן תוכל להשקיע את הקרדיטים שלך ולהכפיל אותם.\n"
            "המערכת מחוברת ישירות ליתרת הספאמר שלך.\n\n"
            "📜 **חוקי הבורסה:**\n"
            "• לוחצים על הכפתור למטה כדי לפתוח השקעה.\n"
            "• בוחרים סכום ומחכים לניתוח השוק (3 שניות).\n"
            "• **סיכוי הצלחה:** 30%\n"
            "• **בונוס:** זכייה מעניקה **פי 2** מהסכום!\n\n"
            "⚠️ *השקעה בסיכון גבוה - היזהרו מהפסדים!*"
        ),
        color=0x2ecc71 # ירוק "כסף"
    )
    await interaction.channel.send(embed=embed, view=MarketView())
    await interaction.response.send_message("✅ המערכת הותקנה!", ephemeral=True)
